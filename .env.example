# ---- Core ----
# SQLite database file (relative to project root or absolute path)
DATABASE_URL=./data/app.db
PORT=3000
# Set this when running behind Cloudflare Tunnel / HTTPS so cookies are marked Secure.
# Leave empty for local http://localhost.
BASE_URL=http://localhost:3000
# Trust reverse proxy headers (Cloudflare Tunnel sends X-Forwarded-*)
TRUST_PROXY=true
SESSION_SECRET=change-me-to-a-long-random-string-please-32bytes-min

# ---- Super Admin (bootstrap only, created on db:init) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- AI (9Router, OpenAI-compatible). Can also be edited from the dashboard. ----
AI_BASE_URL=http://localhost:20128/v1
# AI_API_KEY takes precedence; ROUTER_API_KEY is an env-only fallback.
AI_API_KEY=
# AI_DEFAULT_MODEL=rv/deepseek-ai/DeepSeek-V4.1-Flash

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# ---- Storage directories (relative to project root) ----
INPUT_DIR=./storage/inputs
PROJECT_DIR=./storage/projects
TEMP_DIR=./storage/temp
PREVIEW_DIR=./storage/previews
OUTPUT_DIR=./storage/outputs

# ---- Tools ----
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Python executable used for the faster-whisper / opencv sidecars
PYTHON_PATH=python
# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Job queue ----
# SQLite-backed queue works out of the box. Set to "redis" to use BullMQ/Redis.
QUEUE_DRIVER=sqlite
REDIS_URL=redis://localhost:6379
